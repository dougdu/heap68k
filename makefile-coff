#
# Makefile for building libheap-coff.a
#
# A library that supports a simple heap management API.
#

# Definitions for Assembler

.SUFFIXES: .a68 .a

ASM       =C:\git\worm68k\68kTools\builds\win64\bin\Release\asm68K.exe
COFF_FLAGS=/Cx /coff /Fl /Fm /Zi /nologo
AINC      =/Isrc
LD        =C:\git\worm68k\tools\coff\m68k-coff-ld.exe
LDSCRIPT  =C:\git\worm68k\tools\cpm68k-coff.ld
AR        =C:\git\worm68k\tools\coff\m68k-coff-ar.exe
RANLIB	  =C:\git\worm68k\tools\coff\m68k-coff-ranlib.exe
BINDIR    =C:\git\worm68k\bin
LIBDIR    =C:\git\worm68k\lib
INCDIR    =C:\git\worm68k\include

{src}.a68.obj:
	$(ASM) $(COFF_FLAGS) $(AINC) /Fo$@ /Fl$(@R).lst /c $<

{test}.a68{test}.obj:
	$(ASM) $(COFF_FLAGS) $(AINC) /Itest /Fo$@ /Fl$(@R).lst /c $<

# targets
HEAP_COFF_OBJS = GetMachineHeap.obj GetMachineHeaps.obj \
	   HeapAlloc.obj HeapAutoValidateFlagCheck.obj HeapCoalesce.obj HeapCompact.obj \
	   HeapCreate.obj HeapDestroy.obj HeapFree.obj HeapGetError.obj HeapInitialize.obj \
	   HeapReAlloc.obj HeapSize.obj HeapStats.obj HeapUnlinkFromBlockChain.obj \
	   HeapUnlinkFromFreeBlockChain.obj HeapValidate.obj \
	   HeapValidateHandle.obj HeapWalk.obj HeapData.obj \
	   HeapDebugFillOnFree.obj HeapInvalidateBlockHeader.obj \
	   HeapSmallCtl.obj HeapArena.obj HeapSlab.obj HeapSmallAlloc.obj HeapSmallFree.obj \
	   HeapSmallReAlloc.obj HeapSmallValidate.obj HeapSmallCompact.obj HeapSmallWalk.obj

all: libheap-coff.a test\heaptest.cof

libheap-coff.a: $(HEAP_COFF_OBJS)
	$(AR) -rscv libheap-coff.a $**
	copy src\heap.inc $(INCDIR)
	copy libheap-coff.a $(LIBDIR)

test\heaptest.cof: test\HeapTest.obj libheap-coff.a
	$(LD) -T $(LDSCRIPT) -Ttext 500 test\HeapTest.obj -L $(LIBDIR) -lheap-coff -o $@
	copy $@ $(BINDIR)

