# Test program for libheap-coff.a
test\HeapTest.obj: test\HeapTest.a68 heap.inc libheap-coff.a makefile-coff

clean:
	del *.68k
	del *.a
	del *.obj
	del *.lst
	del test\*.68k test\*.cof test\*.obj test\*.lst
