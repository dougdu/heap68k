	include	heap.inc

	extern	_MachineHeapInitialize
	extern 	_HeapCreate, _HeapDestroy
	extern 	_HeapAlloc, _HeapFree

	.code


lowtpa	equ	$00
hightpa	equ	$04
csstart	equ	$08
cslen 	equ   	$0C
dsstart	equ 	$10
dslen 	equ 	$14
bsstart	equ	$18
bslen	equ	$1C
freelen equ	$20
cmdtail	equ 	$80

STKSIZE	equ	$200

start:	; Get the pointer to the base page
	move.l 	(sp)+,a0 		; A0 --> Base page

	; Initialize stack
	move.l 	hightpa(a0),d1
	movea.l d1,a7 			; USP --> hightpa

	; Compute heap start
	move.l 	bsstart(a0),d2 		; A1 --> Start of bss segment
	add.l 	bslen(a0),d2 		; D2 = Heap start after BSS segment

	; Compute heap size
	sub.l 	d2,d1 			; hightpa - heapstart
	subi.l 	#STKSIZE,d1 		; reserve room for stack
	subi.l 	#96,d1 			; Some slop for block aligning

	; Initialize the machine heap
	move.l 	d1,-(sp)		; Push heap size
	move.l 	d2,-(sp)		; Push start address
	clr.l 	-(sp)			; No options
	jsr 	_MachineHeapInitialize	; Create the Machine heap
	adda.l 	#12,sp

ttHeapCreate:
	move.l 	#$3000,-(sp)
	move.l 	#HEAP_ENABLE_DEBUG_FILL,-(sp)
	jsr 	_HeapCreate
	adda.l 	#8,sp
	move.l 	d0,_PrivateHeap1	; Save heap handle

	move.l 	#310,-(sp)		; Allocate 50 bytes
	clr.l 	-(sp)			; No flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapAlloc
	adda.l 	#12,sp
	move.l 	d0,blk1

	move.l 	#320,-(sp)		; Allocate 50 bytes
	clr.l 	-(sp)			; No flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapAlloc
	adda.l 	#12,sp
	move.l 	d0,blk2

	move.l 	#330,-(sp)		; Allocate 50 bytes
	clr.l 	-(sp)			; No flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapAlloc
	adda.l 	#12,sp
	move.l 	d0,blk3

	move.l 	#100,-(sp)		; Allocate 50 bytes
	clr.l 	-(sp)			; No flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapAlloc
	adda.l 	#12,sp
	move.l 	d0,blk4

	move.l 	blk1,-(sp)		; Free block 1
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapFree
	adda.l 	#8,sp

	move.l 	blk3,-(sp)		; Free block 3
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapFree
	adda.l 	#8,sp

done: 	jmp 	done

	.bss

blk1:	ds.l 	1
blk2:	ds.l 	1
blk3:	ds.l 	1
blk4:	ds.l 	1

_PrivateHeap1:
	ds.l	1

	end
