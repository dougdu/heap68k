	include	heap.inc

	extern	_MachineHeapInitialize
	extern 	_HeapCreate, _HeapDestroy
	extern 	_HeapAlloc, _HeapReAlloc, _HeapFree
	extern 	_HeapCompact, _GetMachineHeap, _GetMachineHeaps
	extern  _HeapWalk, _HeapGetError, _HeapSize

	.code


lowtpa	equ	$00
hightpa	equ	$04
csstart	equ	$08
cslen 	equ   	$0C
dsstart	equ 	$10
dslen 	equ 	$14
bsstart	equ	$18
bslen	equ	$1C
freelen equ	$20
cmdtail	equ 	$80

STKSIZE	equ	$200

;HEAP_FLAGS equ	(FLG_HEAP_DISABLE_COALESCING or HEAP_ENABLE_DEBUG_FILL)
;HEAP_FLAGS equ	(HEAP_ENABLE_DEBUG_FILL or HEAP_TAIL_CHECKING_ENABLED)
;HEAP_FLAGS equ	(HEAP_ZERO_MEMORY or HEAP_TAIL_CHECKING_ENABLED)
HEAP_FLAGS equ	HEAP_ENABLE_DEBUG_FILL

start:	; Get the pointer to the base page
	move.l 	(sp)+,a0 		; A0 --> Base page

	; Initialize stack
	move.l 	hightpa(a0),d1
	movea.l d1,a7 			; USP --> hightpa

	; Compute heap start
	move.l 	bsstart(a0),d2 		; A1 --> Start of bss segment
	add.l 	bslen(a0),d2 		; D2 = Heap start after BSS segment

	; Compute heap size
	sub.l 	d2,d1 			; hightpa - heapstart
	subi.l 	#STKSIZE,d1 		; reserve room for stack
	subi.l 	#96,d1 			; Some slop for block aligning

	; Initialize the machine heap
	move.l 	d1,-(sp)		; Push heap size
	move.l 	d2,-(sp)		; Push start address
	clr.l 	-(sp)			; No options
	jsr 	_MachineHeapInitialize	; Create the Machine heap
	adda.l 	#12,sp
	move.l  d0,hDefaultHeap

ttHeapCreate:
	move.l 	#400,-(sp)
	move.l 	#HEAP_FLAGS,-(sp)
	jsr 	_HeapCreate
	adda.l 	#8,sp
	move.l 	d0,_PrivateHeap1	; Save heap handle

ttalloc1:
	move.l 	#$1,-(sp)		; Allocate 1 bytes
	clr.l 	-(sp)			; No flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapAlloc
	adda.l 	#12,sp
	move.l 	d0,blk1

ttrealloc:
	move.l 	#$40,-(sp)
	move.l 	blk1,-(sp)
	clr.l 	-(sp)			; Flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapReAlloc
	adda.l 	#16,sp

	bra	done



;	movea.l blk1,a0
;	move.l  #5,$20(a0)

ttfree1:
	move.l 	blk1,-(sp)		; Free block 1
;	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	move.l 	hDefaultHeap,-(sp)	; From private heap 1
	jsr 	_HeapFree
	adda.l 	#8,sp

	bra	done


ttalloc2:
	move.l 	#10,-(sp)		; Allocate 10 bytes
	clr.l 	-(sp)			; No flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapAlloc
	adda.l 	#12,sp
	move.l 	d0,blk2

ttalloc3:
	move.l 	#10,-(sp)		; Allocate 10 bytes
	clr.l 	-(sp)			; No flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapAlloc
	adda.l 	#12,sp
	move.l 	d0,blk3

ttalloc4:
	move.l 	#10,-(sp)		; Allocate 10 bytes
	clr.l 	-(sp)			; No flags
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapAlloc
	adda.l 	#12,sp
	move.l 	d0,blk4

;ttfree1:
;	move.l 	blk1,-(sp)		; Free block 1
;	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
;	jsr 	_HeapFree
;	adda.l 	#8,sp

ttfree2:
	move.l 	blk2,-(sp)		; Free block 2
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapFree
	adda.l 	#8,sp

HeapWalkTest:
	move.l	#0,HeapEntry		; HeapEntry --> NULL

HeapWalkLoop:
	move.l 	#HeapEntry,-(sp)	; Push &HeapEntry
	move.l 	_PrivateHeap1,-(sp)	; Push private heap 1
	jsr 	_HeapWalk
	adda.l 	#8,sp
	tst.l 	d0 			; Success?
	beq.s 	HeapWalkFailed

HeapWalkSuccess:
	bra.s 	HeapWalkLoop 		; Get next heap block


HeapWalkFailed:
	jsr 	_HeapGetError 		; Get heap API status
	cmpi.l  #HEAP_ERROR_NO_MORE_ITEMS,d0 ; Just end of the heap?
	beq.s 	HeapWalkTestPassed

HeapWalkTestFailed:
	bra 	_ErrorEnd

HeapWalkTestPassed:
	bra 	done

ttfree3:
	move.l 	blk3,-(sp)		; Free block 3
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapFree
	adda.l 	#8,sp

ttfree4:
	move.l 	blk4,-(sp)		; Free block 3
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapFree
	adda.l 	#8,sp

compact:
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapCompact
	adda.l 	#4,sp


destroy:
	move.l 	_PrivateHeap1,-(sp)	; From private heap 1
	jsr 	_HeapDestroy
	adda.l 	#4,sp
	clr.l 	_PrivateHeap1

done: 	jmp 	done

_ErrorEnd: jmp _ErrorEnd

	.bss

HeapEntry:	ds.l 	1

NumberOfHeaps:	ds.l	1
HeapsIndex:	ds.l	1
HeapsLength: 	ds.l 	1
aHeaps: 	ds.l 	1
hDefaultHeap:	ds.l 	1
BytesToAllocate: ds.l	1

blk1:	ds.l 	1
blk2:	ds.l 	1
blk3:	ds.l 	1
blk4:	ds.l 	1

_PrivateHeap1:
	ds.l	1

	end
