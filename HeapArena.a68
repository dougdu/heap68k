************************************************************************
*  HeapArena
************************************************************************
*
*  Small Object Allocator (SOA) arena management.  An arena owns a
*  compact regular-block descriptor and a separate SLAB_SIZE-aligned
*  regular block containing only tile payload.
*
*    __HeapArenaCreate  - allocate + format a new arena
*    __HeapArenaRelease - unlink + free an arena
*
************************************************************************

	.model	flat

	include heap.inc

	extern	__HeapError

	.code

************************************************************************
*  __HeapArenaCreate
*
*  hHeap  : DWORD - heap handle
*  nTiles : DWORD - desired tiles (clamped to >=1; adaptive down to 1
*                   if the parent heap cannot satisfy the request)
*
*  Returns D0 = arena descriptor pointer, or NULL (0) on failure.
************************************************************************
__HeapArenaCreate PROC USES d2-d4/a0-a3, hHeap:DWORD, nTiles:DWORD
	movea.l hHeap,a0			; A0 --> heap header

	; The arena must be linked into the heap's SCB
	move.l	a0,-(sp)
	jsr	__HeapScbGetOrCreate
	adda.l	#4,sp
	tst.l	d0
	beq	_arcFail
	movea.l d0,a2				; A2 --> SCB

	move.l	nTiles,d2			; D2 = tiles wanted
	moveq	#1,d0				; ...clamped to at least 1
	cmp.l	d0,d2
	bge.s	_arcClampMax
	move.l	d0,d2
_arcClampMax:
	cmpi.l	#ARENA_MAX_SLABS,d2
	bls.s	_arcAllocDescriptor
	move.l	#ARENA_MAX_SLABS,d2

_arcAllocDescriptor:
	; The descriptor is an ordinary non-SOA block.  It is not published
	; until aligned backing allocation and formatting both succeed.
	move.l	#AREN_HDR_SIZE,-(sp)
	move.l	#HEAP_DISABLE_SMALL_POOL,-(sp)
	move.l	a0,-(sp)
	jsr	_HeapAlloc
	adda.l	#12,sp
	tst.l	d0
	beq	_arcFail
	movea.l d0,a1				; A1 --> separately owned descriptor

_arcTry:
	move.l	d2,d3
	mulu	#SLAB_SIZE,d3			; D3 = exact tile payload bytes
	lea	arPadding(a1),a3
	move.l	a3,-(sp)			; pPadding
	move.l	#SLAB_SIZE,-(sp)		; lAlignment
	move.l	d3,-(sp)			; lBytes
	move.l	#HEAP_DISABLE_SMALL_POOL,-(sp)
	move.l	a0,-(sp)
	jsr	__HeapAllocAligned
	adda.l	#20,sp
	tst.l	d0
	bne.s	_arcGot
	; Allocation failed: adaptive shrink to a single-slab arena
	cmpi.l	#1,d2
	beq.s	_arcFreeDescriptor		; already minimal -> give up
	moveq	#1,d2
	bra.s	_arcTry

_arcGot:
	move.l	d0,d4				; D4 = aligned tile backing/base

	; Format and publish the complete descriptor.
	move.l	#AREN_MAGIC,arMagic(a1)
	move.l	d4,arBlock(a1)
	move.l	scbArenaHead(a2),arNext(a1)	; link at head of arena list
	move.l	a1,scbArenaHead(a2)
	move.l	d4,arBase(a1)
	move.w	d2,arSlabs(a1)			; tile count
	clr.w	arSlabUse(a1)
	clr.l	arTileMap(a1)
	addq.l	#1,scbArenaCount(a2)
	move.l	a1,d0				; return descriptor
	bra.s	_arcExit

_arcFreeDescriptor:
	move.l	a1,-(sp)
	move.l	a0,-(sp)
	jsr	_HeapFree
	adda.l	#8,sp
	move.l	#HEAP_ERROR_OUT_OF_MEMORY,__HeapError
_arcFail:
	clr.l	d0
_arcExit:
	ENDP

************************************************************************
*  __HeapArenaRelease
*
*  hHeap : DWORD - heap handle
*  arena : DWORD - arena descriptor to release
*
*  Unlinks the arena from the SCB list and frees its underlying block.
*  Returns D0 = nonzero on success, 0 on failure.
************************************************************************
__HeapArenaRelease PROC USES d1-d2/a0-a3, hHeap:DWORD, arena:DWORD
	movea.l hHeap,a0			; A0 --> heap header
	movea.l arena,a1			; A1 --> arena
	move.l	hhSmallPool(a0),d0
	beq	_arrFail
	movea.l d0,a2				; A2 --> SCB

	; Unlink the arena from the scbArenaHead singly-linked list
	lea	scbArenaHead(a2),a3		; A3 = &slot to update
_arrWalk:
	move.l	(a3),d0				; D0 = current arena
	beq.s	_arrFail
	move.l	arena,d1
	cmp.l	d1,d0
	beq.s	_arrFound
	movea.l d0,a3
	lea	arNext(a3),a3			; A3 = &current->arNext
	bra.s	_arrWalk
_arrFound:
	move.l	arNext(a1),d1			; capture links/ownership before any free
	move.l	arBlock(a1),d2
	move.l	d1,(a3)				; *slot = arena->arNext
	subq.l	#1,scbArenaCount(a2)
	clr.l	arMagic(a1)			; stale descriptors must not be recognized
	clr.l	arNext(a1)

	move.l	d2,-(sp)			; free aligned tile backing first
	move.l	a0,-(sp)
	jsr	_HeapFree
	adda.l	#8,sp
	tst.l	d0
	beq.s	_arrExit
	move.l	a1,-(sp)			; then free the separate descriptor
	move.l	a0,-(sp)
	jsr	_HeapFree
	adda.l	#8,sp
	bra.s	_arrExit

_arrFail:
	clr.l	d0
_arrExit:
	ENDP

	end
