*********************************************************
* _MachineHeapInitialize
*
*     Entry:  D0 = flags
*	      D1 = machine heap size
*
*     Exit:   None
*********************************************************

	include heap.inc

	public 	_MachineHeapInitialize
	extern	__MachineHeapHandle

	.code

_MachineHeapInitialize:
	movem.l d0-d4/a0-a1,-(sp)		; Save registers
	move.l	#__rt_heap,d2			; Get pointer past end of program
	add.l 	#BLK_HDR_SIZE-1,d2		; Align on Heap block size boundary
	andi.b 	#NOT(BLK_HDR_SIZE-1),d2
	movea.l d2,a0				; A0 --> Start of machine heap

	; Compute the actual size of the initial (FREE) block
	move.l 	d1,d4				; Make working copy of requested heap size
        add.l   #BLK_HDR_SIZE-1,d4		; Align the initial block on a block boundary
        andi.b  #NOT(BLK_HDR_SIZE-1),d4
	add.l 	#BLK_HDR_SIZE,d4 		; Add in the size of block's header

	; Compute the size of the entire machine heap
	move.l 	#HEAP_HDR_SIZE,d2 		; Reserve space for header
	add.l 	#BLK_HDR_SIZE-1,d2		; Pad to be a multiple of the heap block size
	andi.b 	#NOT(BLK_HDR_SIZE-1),d2		; D2 = Aligned size of heap header
	move.l 	d2,d3				; D3 = Computed size of entire heap including headers
	add.l 	#HEAP_END_SIZE,d3 		; add in heap end block
	add.l 	d4,d3 				; add in size of free memory

	; Initialize the heap header
	move.l 	#HEAP_MAGIC,hhMagic(a0)		; Initialize MAGIC number
	move.l	d0,hhFlags(a0)			; Save requested heap flags
	move.l 	d1,hhRequestSize(a0)		; Save requested heap size
	move.l 	d3,hhSize(a0)			; Save the machine heap size
	lea.l 	hhHeap(a0,d2.l),a1		; A1 --> Initial free block
	move.l 	a1,hhHeapHead(a0)		; Initialize the pointer to the head of the block list.
	move.l 	a1,hhFreeHead(a0)		; Head of the free block list is the same to start.

	; Initialize the block header
	move.l 	#BLOCK_MAGIC,bhMagic(a1)	; Set the block header magic number
	move.l 	#FLG_FREE,bhFlags(a1)		; Initialize the block to free
	move.l 	d1,bhRequestSize(a1)		; Save the requested size of the heap
	move.l  d4,bhSize(a1)			; Save aligned block size
	clr.l 	bhPrev(a1)			; pointer to the previous block = NULL
	clr.l 	bhNext(a1)			; pointer to the next block = NULL
	clr.l 	bhFreePrev(a1)			; pointer to the previous free block = NULL
	clr.l 	bhFreeNext(a1)			; pointer to the next free block = NULL

	; Fill free memory with marker word "baadf00d"
	lea.l 	bhData(a1),a2			; Start of data area
	move.l 	bhRequestSize(a1),d1 		; Number of bytes to initialize
	lsr.l 	#2,d1				; Fill using long words
	subq.l 	#1,d1 				; Adjust for dbra
_mhiBaadfoodLoop:
	move.l 	#BAADFOOD,(a2)+
	dbra 	d1,_mhiBaadfoodLoop		; Loop until filled

	; Initialize the end of heap marker
	lea.l 	-HEAP_END_SIZE(a0,d3.l),a1 	; A1 --> end of heap marker
	move.l 	#HEAP_END_SIZE,d1 		; Size of end of heap marker in bytes
	lsr.l 	#2,d1 				; Convert to a count of long words
	subq.l 	#1,d1 				; adjust for dbra

_mhiEndMarkerInitLoop:
	move.l 	#HEAP_END,(a1)+			; Put magic word in to detect buffer overruns
	dbra 	d1,_mhiEndMarkerInitLoop	; Fill the end marker with the magic number

	move.l  a0,__MachineHeapHandle		; Save the handle to the machine heap

	movem.l (sp)+,d0-d4/a0-a1		; Restore registers
	rts

	end
