#
# Makefile for building libheap.a
#
# A library that supports the a simple heap management API.
#

# Definitions for Assembler

.SUFFIXES: .a68 .s .bas .a

REPOROOT  ?= $(shell cd ../../../.. && pwd)
ASM       = $(REPOROOT)/68kTools/builds/macos/bin/asm68k
ELF_FLAGS =-Cx -elf -Fl -Fm -nologo
AINC      =-Isrc
LD        = $(REPOROOT)/tools/ld
LDSCRIPT  = $(REPOROOT)/tools/cpm68k.ld
AR        = $(REPOROOT)/tools/ar
RANLIB    = $(REPOROOT)/tools/ranlib
SIM68KDIR = $(REPOROOT)/68kTools/sim68k
LIBDIR    = $(REPOROOT)/lib
INCDIR    = $(REPOROOT)/include

%.o: src/%.a68
	$(ASM) $(ELF_FLAGS) $(AINC) -Fo$@ -Fl$(@:.o=.lst) -c $<

test/%.o: test/%.a68
	$(ASM) $(ELF_FLAGS) $(AINC) -Itest -Fo$@ -Fl$(@:.o=.lst) -c $<

# targets
HEAP_OBJS = GetMachineHeap.o GetMachineHeaps.o \
	   HeapAlloc.o HeapAutoValidateFlagCheck.o HeapCoalesce.o HeapCompact.o \
	   HeapCreate.o HeapDestroy.o HeapFree.o HeapGetError.o HeapInitialize.o \
	   HeapReAlloc.o HeapSize.o HeapStats.o HeapUnlinkFromBlockChain.o \
	   HeapUnlinkFromFreeBlockChain.o HeapValidate.o \
	   HeapValidateHandle.o HeapWalk.o HeapData.o \
	   HeapDebugFillOnFree.o HeapInvalidateBlockHeader.o \
	   HeapSmallCtl.o HeapArena.o HeapSlab.o HeapSmallAlloc.o HeapSmallFree.o \
	   HeapSmallReAlloc.o HeapSmallValidate.o HeapSmallCompact.o HeapSmallWalk.o


all: libheap.a test/heaptest.68k

libheap.a: $(HEAP_OBJS)
	$(AR) -rscv libheap.a $^
	cp src/heap.inc $(INCDIR)
	cp libheap.a $(LIBDIR)

test/heaptest.68k: test/HeapTest.o libheap.a
	$(LD) -T $(LDSCRIPT) -Ttext 1700 test/HeapTest.o -L $(LIBDIR) -lheap -o $@
	cp $@ $(SIM68KDIR)

# Dependencies for Heap source
GetMachineHeap.o: src/GetMachineHeap.a68 src/heap.inc makefile.macos
GetMachineHeaps.o: src/GetMachineHeaps.a68 src/heap.inc makefile.macos
HeapAlloc.o: src/HeapAlloc.a68 src/heap.inc makefile.macos
HeapAutoValidateFlagCheck.o: src/HeapAutoValidateFlagCheck.a68 src/heap.inc makefile.macos
HeapCoalesce.o: src/HeapCoalesce.a68 src/heap.inc makefile.macos
HeapCompact.o: src/HeapCompact.a68 src/heap.inc makefile.macos
HeapCreate.o: src/HeapCreate.a68 src/heap.inc makefile.macos
HeapData.o: src/HeapData.a68 src/heap.inc makefile.macos
HeapDebugFillOnFree.o: src/HeapDebugFillOnFree.a68 src/heap.inc makefile.macos
HeapDestroy.o: src/HeapDestroy.a68 src/heap.inc makefile.macos
HeapFree.o: src/HeapFree.a68 src/heap.inc makefile.macos
HeapGetError.o: src/HeapGetError.a68 makefile.macos
HeapInitialize.o: src/HeapInitialize.a68 src/heap.inc makefile.macos
HeapInvalidateBlockHeader.o: src/HeapInvalidateBlockHeader.a68 src/heap.inc makefile.macos
HeapReAlloc.o: src/HeapReAlloc.a68 src/heap.inc makefile.macos
HeapSize.o: src/HeapSize.a68 src/heap.inc makefile.macos
HeapStats.o: src/HeapStats.a68 src/heap.inc makefile.macos
HeapUnlinkFromBlockChain.o: src/HeapUnlinkFromBlockChain.a68 src/heap.inc makefile.macos
HeapUnlinkFromFreeBlockChain.o: src/HeapUnlinkFromFreeBlockChain.a68 src/heap.inc makefile.macos
HeapValidate.o: src/HeapValidate.a68 src/heap.inc makefile.macos
HeapValidateHandle.o: src/HeapValidateHandle.a68 src/heap.inc makefile.macos
HeapWalk.o: src/HeapWalk.a68 src/heap.inc makefile.macos
HeapSmallCtl.o: src/HeapSmallCtl.a68 src/heap.inc makefile.macos
HeapArena.o: src/HeapArena.a68 src/heap.inc makefile.macos
HeapSlab.o: src/HeapSlab.a68 src/heap.inc makefile.macos
HeapSmallAlloc.o: src/HeapSmallAlloc.a68 src/heap.inc makefile.macos
HeapSmallFree.o: src/HeapSmallFree.a68 src/heap.inc makefile.macos
HeapSmallReAlloc.o: src/HeapSmallReAlloc.a68 src/heap.inc makefile.macos
HeapSmallValidate.o: src/HeapSmallValidate.a68 src/heap.inc makefile.macos
HeapSmallCompact.o: src/HeapSmallCompact.a68 src/heap.inc makefile.macos
HeapSmallWalk.o: src/HeapSmallWalk.a68 src/heap.inc makefile.macos

# Test harness
test/HeapTest.o: test/HeapTest.a68 src/heap.inc libheap.a makefile.macos

clean:
	rm -f *.68k *.a *.o *.lst
	rm -f test/*.68k test/*.o test/*.lst
