************************************************************************
*  _HeapCompact
************************************************************************
*
*  Returns the size of the largest free block in the specified
*  heap. If the Disable heap coalesce on free global flag is set,
*  this function also coalesces adjacent free blocks of memory
*  in the heap.
*
************************************************************************
*  PARAMETERS
************************************************************************
*
*  hHeap  : The heap handle of the heap to compact.
*
************************************************************************
*  RETURN VALUE
************************************************************************
*
*  If the function succeeds, the return value is the size of the
*  largest free block in the heap, in bytes.  If the function fails,
*  the return value is zero. To get extended error information,
*  call GetHeapError. In the unlikely case that there is absolutely
*  no space available in the heap, the function return value is zero,
*  and GetHeapError returns the value HEAP_ERROR_SUCCESS.
*
************************************************************************

	include heap.inc

	public	_HeapCompact
	extern 	__HeapAutoValidateFlagCheck, __HeapCoalesce

	.code

; Parameter offsets
hHeap	equ 	8

; Local offsets
_HeapCompact:
	link 	a6,#0				; Initialize stack frame
	movem.l d1/a0-a1,-(sp)			; Save registers

	movea.l hHeap(a6),a0 			; A0 --> Heap Header

	; Run any configured heap validations
	clr.l 	-(sp)				; Flag caller as not HeapFree
	move.l 	a0,-(sp)			; Push heap handle
	jsr 	__HeapAutoValidateFlagCheck
	adda.l 	#8,sp
	bne 	_hcpError			; Validation failed

	btst.l 	#FLG_HEAP_DISABLE_COALESCING,d0 ; Coalescing disabled?
	beq.s	_hcpNoCoalesce 			; Nope, heap should be good

	; Here we walk the free list and coalesce all the adjacent
	; free blocks.

	tst.l 	hhFreeHead(a0)			; Are there any free blocks?
	beq.s 	_hcpNoCoalesce			; Nope, nothing to coalesce

_hcpResetCoalesceLoop:
	movea.l hhFreeHead(a0),a1 		; A1 --> head of the free block chain

_hcpCoalesceLoop:
	move.l 	a1,-(sp)			; Push the block address
	move.l 	a0,-(sp)			; Push heap handle
	jsr 	__HeapCoalesce			; Attempt to coalesce the block
	adda.l 	12,sp
	tst.l 	d0 				; Was the block coalesced?
	bne.s 	_hcpResetCoalesceLoop		; Yes, restart the free list walk
	movea.l bhFreeNext(a1),a1 		; Follow link to next block
	cmpa.l 	#0,a1 				; End of the free block chain?
	bne.s 	_hcpCoalesceLoop		; Nope, try and coalesce the next block

_hcpNoCoalesce:
	movea.l hhFreeHead(a0),a1 		; A1 --> start of free block chain
	clr.l 	d0 				; D0 = largest free block

_hcpFindLargestFreeBlockLoop:
	cmpa.l 	#0,a1 				; End of the free block chain?
	beq.s	_hcpExitFindLoop		; Yes, return largest free block found
	move.l 	bhSize(a1),d1 			; D1 = size of free block
	cmp.l 	d1,d0				; New block larger than currently cached size?
	bge.s 	_hcpNotLarger			; Nope, move on to next block
	move.l 	d1,d0 				; Update largest block size

_hcpNotLarger:
	movea.l bhFreeNext(a1),a1 		; Follow forward link and loop
	bra.s 	_hcpFindLargestFreeBlockLoop

_hcpExitFindLoop:
	tst.l 	d0 				; Is final size 0?
	beq.s 	_hcpExit			; Yes, return it
	subi.l 	#BLK_HDR_SIZE,d0		; Nope, only return the data portion

_hcpExit:
	movem.l (sp)+,d1/a0-a1			; Restore registers
	unlk	a6
	rts

_hcpError:
	clr.l 	d0
	bra.s 	_hcpExit

	end
