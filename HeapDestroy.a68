************************************************************************
*  _HeapDestroy
************************************************************************
*
*  Destroys the specified heap object and it invalidates the handle
*  to the heap.
*
************************************************************************
*  PARAMETERS
************************************************************************
*
*  hHeap : A handle to the heap to be destroyed. This handle is
*          returned by the HeapCreate function. Do not use the
*          handle to the machine heap returned by the
*	   _MachineHeapInitialize function.
*
************************************************************************
*  RETURN VALUE
************************************************************************
*
*  If the function succeeds,
*
************************************************************************

	include heap.inc

	public 	_HeapDestroy

	.code

; Parameter offsets
hHeap	equ 	8

_HeapDestroy:
	link 	a6,#0

	unlk 	a6
	rts

        end
