#
# Makefile for building libheap-elf.a
#
# A library that supports a simple heap management API.
#

# Definitions for Assembler

.SUFFIXES: .a68 .a

ASM       =C:\git\worm68k\68kTools\builds\win64\bin\Release\asm68K.exe
ELF_FLAGS =/Cx /elf /Fl /Fm /Zi /nologo
AINC      =/I.
LD        =C:\git\worm68k\tools\elf\m68k-elf-ld.exe
LDSCRIPT  =C:\git\worm68k\tools\cpm68k.ld
AR        =C:\git\worm68k\tools\elf\m68k-elf-ar.exe
RANLIB	  =C:\git\worm68k\tools\elf\m68k-elf-ranlib.exe
LIBDIR    =C:\git\worm68k\lib
INCDIR    =C:\git\worm68k\include
BINDIR    =C:\git\worm68k\bin

.a68.o:
	$(ASM) $(ELF_FLAGS) $(AINC) /c $<

# targets

HEAP_ELF_OBJS = GetMachineHeap.o GetMachineHeaps.o \
	   HeapAlloc.o HeapAutoValidateFlagCheck.o HeapCoalesce.o HeapCompact.o \
	   HeapCreate.o HeapDestroy.o HeapFree.o HeapGetError.o HeapInitialize.o \
	   HeapReAlloc.o HeapSize.o HeapStats.o HeapUnlinkFromBlockChain.o \
	   HeapUnlinkFromFreeBlockChain.o HeapValidate.o \
	   HeapValidateHandle.o HeapWalk.o HeapData.o \
	   HeapDebugFillOnFree.o HeapInvalidateBlockHeader.o \
	   HeapSmallCtl.o HeapArena.o HeapSlab.o HeapSmallAlloc.o HeapSmallFree.o \
	   HeapSmallReAlloc.o HeapSmallValidate.o HeapSmallCompact.o HeapSmallWalk.o


all: libheap-elf.a heaptest.elf heapsmalltest.elf

libheap-elf.a: $(HEAP_ELF_OBJS)
	$(AR) -rscv $@ $**
	copy Heap.inc $(INCDIR)
	copy $@ $(LIBDIR)

heaptest.elf:  heaptest.o libheap-elf.a
	$(LD) -T $(LDSCRIPT) -Ttext 500 heaptest.o -L $(LIBDIR) -lheap-elf -o $@ 
	copy $@ $(BINDIR)

heapsmalltest.elf:  heapsmalltest.o libheap-elf.a
	$(LD) -T $(LDSCRIPT) -Ttext 500 heapsmalltest.o -L $(LIBDIR) -lheap-elf -o $@ 
	copy $@ $(BINDIR)

